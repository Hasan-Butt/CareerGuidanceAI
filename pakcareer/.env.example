# Backend Configuration
# For local dev without Postgres, leave DATABASE_URL unset to use SQLite automatically
# DATABASE_URL=postgresql+psycopg2://pakcareer:<password>@localhost:5432/pakcareer
POSTGRES_PASSWORD=change-me
PORT=8000
# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000
# Operator key for POST /api/orgs (creating schools). Leave empty to disable.
ADMIN_KEY=
# Folder holding final_model.pkl and label_encoder.pkl (default: <repo>/models/weights)
# MODEL_DIR=

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_INTERNAL_URL=http://localhost:8000
